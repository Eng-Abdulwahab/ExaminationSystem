        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Subject {\n        +Guid Id\n        +string Name\n        +Exam Exam\n        +CreateExam(exam : Exam) void\n        +ToString() string\n    }\n\n    class Exam {\n        &lt;&lt;abstract&gt;&gt;\n        +int Time\n        +int NumberOfQuestions\n        +Question[] Questions\n        +ShowExam() void\n    }\n\n    class FinalExam {\n        +ShowExam() void\n    }\n\n    class PracticalExam {\n        +ShowExam() void\n    }\n\n    class Question {\n        &lt;&lt;abstract&gt;&gt;\n        +string Header\n        +string Body\n        +int Mark\n        +Answer[] AnswerList\n        +Answer RightAnswer\n        +ShowQuestion() void\n        +ToString() string\n    }\n\n    class MCQQuestion {\n        +ShowQuestion() void\n    }\n\n    class TrueOrFalseQuestion {\n        +ShowQuestion() void\n    }\n\n    class Answer {\n        +Guid Id\n        +string Text\n        +ToString() string\n        +Clone() object\n        +CompareTo(object obj) int\n    }\n\n    class ICloneable {\n        &lt;&lt;interface&gt;&gt;\n        +Clone() object\n    }\n\n    class IComparable {\n        &lt;&lt;interface&gt;&gt;\n        +CompareTo(object obj) int\n    }\n\n    Subject \&quot;1\&quot; *-- \&quot;0..1\&quot; Exam : owns\n    Exam &lt;|-- FinalExam\n    Exam &lt;|-- PracticalExam\n\n    Exam \&quot;1\&quot; *-- \&quot;1..*\&quot; Question : contains\n\n    Question &lt;|-- MCQQuestion\n    Question &lt;|-- TrueOrFalseQuestion\n\n    Question \&quot;1\&quot; *-- \&quot;1..*\&quot; Answer : contains\n\n    Answer ..|&gt; ICloneable\n    Answer ..|&gt; IComparable&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DHxZ4pFmPiuBVFe_t6dt-1">
